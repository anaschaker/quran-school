# نسخ هذا الملف إلى .env ثم تعديل القيم عند الحاجة
DATABASE_URL="file:./dev.db"

# مفتاح توقيع جلسات JWT — استبدله بمفتاح عشوائي قوي (32 بايت على الأقل)
# يمكن توليده بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-bytes"

# إعدادات البريد الإلكتروني (SMTP) — اختيارية. إن لم تُضبط تُتجاهل القناة بصمت.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# واتساب (Meta Cloud API) — اختيارية، معطّلة افتراضياً.
WHATSAPP_ENABLED="false"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
