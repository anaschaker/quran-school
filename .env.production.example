# ==========================================================================
# نموذج متغيرات البيئة للإنتاج — مدرسة القرآن الكريم
# --------------------------------------------------------------------------
# 1) انسخ هذا الملف إلى .env على الخادم:  cp .env.production.example .env
# 2) استبدل كل قيمة مكتوب أمامها «غيّرني» بقيمة حقيقية.
# 3) لا ترفع ملف .env إلى أي مستودع أو خدمة خارجية، ولا تشاركه عبر واتساب.
# 4) بعد التعديل أعد تشغيل الحاوية:  docker compose up -d
# ==========================================================================

# --------------------------------------------------------------------------
# قاعدة البيانات (إلزامي)
# --------------------------------------------------------------------------
# مسار ملف SQLite داخل الحاوية. اتركه كما هو عند استخدام docker-compose،
# لأن المجلد /data محفوظ في volume دائم ولا يُفقد عند إعادة بناء الحاوية.
# عند التشغيل بدون Docker استخدم: DATABASE_URL="file:./dev.db"
DATABASE_URL="file:/data/dev.db"

# --------------------------------------------------------------------------
# سر جلسات الدخول (إلزامي — الأهم)
# --------------------------------------------------------------------------
# مفتاح عشوائي قوي لا يقل عن 32 بايت، يُستخدم لتوقيع كوكي الجلسة.
# ولّده على الخادم بالأمر:  sh scripts/generate-secret.sh
# لا تعِد استخدام المفتاح التجريبي، ولا تغيّره بعد بدء الاستخدام وإلا
# سيُطرد جميع المستخدمين وسيضطرون لتسجيل الدخول من جديد.
AUTH_SECRET="غيّرني-إلى-سر-عشوائي-طويل-لا-يقل-عن-32-بايت"

# --------------------------------------------------------------------------
# رابط الموقع العام (مهم للشهادات والروابط في الإشعارات)
# --------------------------------------------------------------------------
# العنوان الذي يفتحه المستخدمون في المتصفح، مع https وبدون / في النهاية.
# مثال: https://quran-school.example.com
NEXT_PUBLIC_SITE_URL="https://example.com"

# --------------------------------------------------------------------------
# بيانات التواصل والبريد (يُنصح بضبطها)
# --------------------------------------------------------------------------
# بريد المدرسة الذي تظهر رسائله كمرسل، ويُستخدم للرد على أولياء الأمور.
# يجب أن يكون نفس البريد المضبوط في SMTP_USER لمعظم مزوّدي البريد.
MAIL_FROM="مدرسة القرآن الكريم <quraanschool11@gmail.com>"

# خادم البريد (SMTP). إن تركته فارغًا تعمل المنصة لكن قناة البريد تُعطّل
# بصمت (تُسجَّل محاولات الإرسال كـ SKIPPED في سجل التسليم).
# أمثلة: Gmail: smtp.gmail.com / المنفذ 587
#         Outlook: smtp.office365.com / 587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# كلمة مرور التطبيق (App Password) وليست كلمة مرور الحساب العادية.
SMTP_PASS=""

# --------------------------------------------------------------------------
# واتساب عبر Meta Cloud API (اختياري تمامًا)
# --------------------------------------------------------------------------
# يُرسل فقط حدثي الغياب وتذكير الرسوم، وفقط لأولياء الأمور الذين وافقوا
# على استلام رسائل واتساب من صفحة /account.
WHATSAPP_ENABLED="false"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# --------------------------------------------------------------------------
# إعدادات الحساب الأول (تُستخدم مرة واحدة عند init-production فقط)
# --------------------------------------------------------------------------
# يمكنك وضعها هنا مؤقتًا ثم حذفها بعد إنشاء المدير، أو تمريرها كمتغيرات
# بيئة عند التشغيل. كلمة المرور يجب ألا تقل عن 10 أحرف.
ADMIN_NAME="مدير المدرسة"
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE=""
ADMIN_PASSWORD="غيّرني-إلى-كلمة-مرور-قوية"
